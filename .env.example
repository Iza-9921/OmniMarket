# Plantilla de variables de entorno. Copia este archivo a `.env.local`
# y nunca subas al repositorio los valores reales.

# PostgreSQL. En local: postgres://<usuario>@localhost:5432/omnimarket_dev
# En Vercel la crea la integración de Neon (también DATABASE_URL_UNPOOLED,
# que usan las migraciones).
DATABASE_URL=

# Token que exige POST /api/test/reset-data en la cabecera `x-test-token`.
# Sin esta variable el endpoint responde 503 (deshabilitado).
TEST_ENDPOINTS_TOKEN=

# Auth.js (OAuth). AUTH_SECRET firma las sesiones: genera uno con `openssl rand -base64 32`.
AUTH_SECRET=
# Credenciales de las apps OAuth (callback: <origen>/api/auth/callback/google | github).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
